<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Invoice</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        /* Custom color for the specific green used in the image */
        .bg-brand-green {
            background-color: #83b238;
        }
        .bg-brand-yellow {
            background-color: #e9d202;
        }
        .text-brand-green {
            color: #83b238;
        }
        .text-brand-dark {
            color: #1a2c42;
        }
    </style>
</head>
<body class="bg-gray-100 py-10 min-h-screen font-sans">

    <!-- Main Container -->
    <div class="max-w-4xl mx-auto bg-white p-10 md:p-14 shadow-lg">

        <!-- Header Section -->
        <header class="flex flex-col md:flex-row justify-between items-start mb-12">
            <div>                
                <h1 class="text-3xl font-extrabold text-brand-dark mb-1"><%= invoice.organization.name %></h1>
                <p class="text-sm text-gray-600"><%= invoice.organization.address %></p>
                <p class="text-sm text-gray-600"><%= invoice.organization.phone %> | <%= invoice.organization.email %></p>
            </div>
        </header>

        <!-- Recipient & Receipt Info Section -->
        <div class="flex flex-col md:flex-row justify-between mb-10 gap-8">
            <!-- Left: Recipient -->
            <div class="md:w-1/2">
                <h3 class="text-xs font-bold text-brand-dark uppercase tracking-widest mb-3">Recipient:</h3>
                <h2 class="text-2xl font-bold text-brand-dark mb-1"><%= invoice.reference?.name %></h2>
                <p class="text-gray-600"><%= invoice.reference?.address %></p>
                <p class="text-gray-600"><%= invoice.reference?.phone %></p>
            </div>

            <!-- Right: Receipt Number & Date -->
            <div class="md:w-[40%] flex flex-col justify-start">
                <div class="bg-brand-green text-white px-5 py-3 text-center">
                    <h2 class="font-bold">No. <%= invoice.code %></h2>
                </div>
                
                <div class="<%= invoice.status == 'success' ? 'bg-brand-green' : 'bg-brand-yellow' %> text-white px-5 py-3 text-center">
                    <h2 class="font-bold"><%= invoice.status.toUpperCase() %></h2>
                </div>
            </div>
        </div>

        <!-- Table Section -->
        <div class="overflow-x-auto mb-10">
            <table class="w-full text-left border-collapse min-w-[700px]">
                <thead>
                    <tr class="bg-brand-green text-white text-xs uppercase tracking-wider">
                        <th class="py-3 px-4 font-bold w-1/4">Product / Service</th>
                        <th class="py-3 px-4 font-bold text-center w-24">Qty.</th>
                        <th class="py-3 px-4 font-bold text-right w-32">Cost</th>
                        <th class="py-3 px-4 font-bold text-right w-32">Discount</th>
                        <th class="py-3 px-4 font-bold text-right w-32">Total</th>
                    </tr>
                </thead>
                <tbody class="text-sm text-gray-800">
                    <!-- Row 1 -->
                     <% invoice.items.forEach(function(item){ %>
                        <tr class="border-b border-gray-100">
                        <td class="py-5 px-4 align-top"><%= item.name %></td>
                        <td class="py-5 px-4 align-top text-center"><%= item.qty %></td>
                        <td class="py-5 px-4 align-top text-right"><%= item.price_format %></td>
                        <td class="py-5 px-4 align-top text-right"><%= item.discount_format %></td>
                        <td class="py-5 px-4 align-top text-right"><%= item.subtotal_format %></td>
                    </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>

        <!-- Footer Section (Totals) -->
        <div class="flex flex-col-reverse md:flex-row justify-between items-end md:items-start gap-8">
            <!-- Left: Thank you message -->
            <div class="w-full md:w-1/2 pt-16">
                <p class="text-gray-500 text-sm">Thanks for your business!</p>
            </div>

            <!-- Right: Calculation -->
            <div class="w-full md:w-[40%]">
                <h3 class="text-xl font-bold text-brand-dark mb-4">Receipt for Payment</h3>
                
                <div class="flex justify-between py-1 border-b border-gray-100">
                    <span class="text-gray-600">Subtotal</span>
                    <span class="text-gray-800"><%= invoice.items.reduce((accumulator, currentItem) => {
                    return parseFloat(accumulator) + parseFloat(currentItem.subtotal);
                    }, 0).toLocaleString('id-ID'); %></span>
                </div>
                
                <% if(invoice.dicount_price > 0){ %>
                <div class="flex justify-between py-1 border-b border-gray-100">
                    <span class="text-gray-600">Discount <%= invoice.discount_alias != 0 ? `(${invoice.discount_alias})` : '' %></span>
                    <span class="text-gray-800"><%= invoice.dicount_price %></span>
                </div>
                <% } %>
                
                <div class="flex justify-between py-1 border-b border-gray-100">
                    <span class="text-gray-600">Total</span>
                    <span class="text-gray-800"><%= parseInt(invoice.total_price).toLocaleString('id-ID') %></span>
                </div>

                <% if(invoice.tax_price > 0){ %>
                <div class="flex justify-between py-1 border-b border-gray-100">
                    <span class="text-gray-600">Tax (<%= invoice.tax_alias %>)</span>
                    <span class="text-gray-800"><%= invoice.tax_price %></span>
                </div>
                <% } %>
                
                <div class="flex justify-between py-4 mt-1">
                    <span class="font-bold text-gray-900 text-base">Total</span>
                    <span class="font-bold text-gray-900 text-base"><%= parseInt(invoice.final_price).toLocaleString('id-ID') %></span>
                </div>
            </div>
        </div>

    </div>

</body>
</html>