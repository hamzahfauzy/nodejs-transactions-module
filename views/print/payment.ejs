<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Invoice</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        /* Custom color for the specific green used in the image */
        .bg-brand-green {
            background-color: #83b238;
        }
        .text-brand-green {
            color: #83b238;
        }
        .text-brand-dark {
            color: #1a2c42;
        }
    </style>
</head>
<body class="bg-gray-100 py-10 min-h-screen font-sans">

    <!-- Main Container -->
    <div class="max-w-4xl mx-auto bg-white p-10 md:p-14 shadow-lg">

        <!-- Header Section -->
        <header class="flex flex-col md:flex-row justify-between items-start mb-12">
            <div>
                <!-- Logo Placehoder (SVG mimicking the logo in image) -->
                <svg width="70" height="50" viewBox="0 0 100 60" xmlns="http://www.w3.org/2000/svg" class="mb-4">
                    <ellipse cx="50" cy="30" rx="48" ry="28" fill="#1b426a"/>
                    <ellipse cx="50" cy="30" rx="42" ry="24" fill="none" stroke="#2c67a5" stroke-width="2"/>
                    <text x="50" y="37" font-family="Arial, sans-serif" font-size="20" font-weight="900" fill="white" text-anchor="middle" letter-spacing="1">LOGO</text>
                </svg>
                
                <h1 class="text-3xl font-extrabold text-brand-dark mb-1">Quest Provider</h1>
                <p class="text-sm text-gray-600">3150 McGavock Pk, Nashville, Tennessee, 37214, US</p>
                <p class="text-sm text-gray-600">(555) 555-5555 | hello@questprovider.com</p>
            </div>
        </header>

        <!-- Recipient & Receipt Info Section -->
        <div class="flex flex-col md:flex-row justify-between mb-10 gap-8">
            <!-- Left: Recipient -->
            <div class="md:w-1/2">
                <h3 class="text-xs font-bold text-brand-dark uppercase tracking-widest mb-3">Recipient:</h3>
                <h2 class="text-2xl font-bold text-brand-dark mb-1">John Hawk</h2>
                <p class="text-gray-600">1 Titans Way</p>
                <p class="text-gray-600">Nashville, Tennessee 37213</p>
            </div>

            <!-- Right: Receipt Number & Date -->
            <div class="md:w-[40%] flex flex-col justify-start">
                <div class="bg-brand-green text-white px-5 py-3">
                    <h2 class="text-2xl font-bold">Receipt for #<%= code %?></h2>
                </div>
                <div class="bg-gray-100 text-gray-700 px-5 py-2 text-sm">
                    Transaction Date: October 27, 2023
                </div>
            </div>
        </div>

        <!-- Table Section -->
        <div class="overflow-x-auto mb-10">
            <table class="w-full text-left border-collapse min-w-[700px]">
                <thead>
                    <tr class="bg-brand-green text-white text-xs uppercase tracking-wider">
                        <th class="py-3 px-4 font-bold w-1/4">Product / Service</th>
                        <th class="py-3 px-4 font-bold w-2/5">Description</th>
                        <th class="py-3 px-4 font-bold text-center w-24">Qty.</th>
                        <th class="py-3 px-4 font-bold text-right w-32">Cost</th>
                        <th class="py-3 px-4 font-bold text-right w-32">Total</th>
                    </tr>
                </thead>
                <tbody class="text-sm text-gray-800">
                    <!-- Row 1 -->
                    <tr class="border-b border-gray-100">
                        <td class="py-5 px-4 align-top">Property maintenance<br>services (hourly)</td>
                        <td class="py-5 px-4 align-top"></td>
                        <td class="py-5 px-4 align-top text-center">20</td>
                        <td class="py-5 px-4 align-top text-right">80.00</td>
                        <td class="py-5 px-4 align-top text-right">$1,600.00</td>
                    </tr>
                    <!-- Row 2 -->
                    <tr class="border-b border-gray-100">
                        <td class="py-5 px-4 align-top">Yard maintenance<br>services (hourly)</td>
                        <td class="py-5 px-4 align-top"></td>
                        <td class="py-5 px-4 align-top text-center">20</td>
                        <td class="py-5 px-4 align-top text-right">80.00</td>
                        <td class="py-5 px-4 align-top text-right">$1,600.00</td>
                    </tr>
                    <!-- Row 3 -->
                    <tr class="border-b border-gray-100">
                        <td class="py-5 px-4 align-top">One-off junk removal</td>
                        <td class="py-5 px-4 align-top pr-10">Clearance of bulky furniture throughout<br>property. Excludes carpets, curtains,<br>fixtures and fittings.</td>
                        <td class="py-5 px-4 align-top text-center">1</td>
                        <td class="py-5 px-4 align-top text-right">310.00</td>
                        <td class="py-5 px-4 align-top text-right">$310.00</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Footer Section (Totals) -->
        <div class="flex flex-col-reverse md:flex-row justify-between items-end md:items-start gap-8">
            <!-- Left: Thank you message -->
            <div class="w-full md:w-1/2 pt-16">
                <p class="text-gray-500 text-sm">Thanks for your business!</p>
            </div>

            <!-- Right: Calculation -->
            <div class="w-full md:w-[40%]">
                <h3 class="text-xl font-bold text-brand-dark mb-4">Receipt for Payment</h3>
                
                <div class="flex justify-between py-3 border-b border-gray-100">
                    <span class="text-gray-600">Subtotal</span>
                    <span class="text-gray-800">$3,510.00</span>
                </div>
                
                <div class="flex justify-between py-3 border-b border-gray-100">
                    <span class="text-gray-600">Tax (13%)</span>
                    <span class="text-gray-800">$456.30</span>
                </div>
                
                <div class="flex justify-between py-4 mt-1">
                    <span class="font-bold text-gray-900 text-base">Total</span>
                    <span class="font-bold text-gray-900 text-base">$3,966.30</span>
                </div>
            </div>
        </div>

    </div>

</body>
</html>